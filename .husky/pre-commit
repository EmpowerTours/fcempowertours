#!/usr/bin/env sh

echo "🔍 Running pre-commit checks..."

# 1. Check for hardcoded secrets (actual values, not env var references)
echo "🔐 Checking for exposed secrets..."
#
# A private key and a keccak hash are both 0x + 64 hex and cannot be told apart by shape, so a
# bare pattern flags every digest, typehash, storage slot and tx hash in the repo. A gate that
# cries wolf on ordinary Solidity constants is one that gets bypassed by habit, which is worse
# than no gate — so a match is ignored when it sits in an unambiguous hash context.
#
# The context is checked on the surrounding lines, not just the matching one: prettier wraps
# `const someDigest =` onto its own line and leaves the literal alone on the next.
#
# Anything outside that context still fails. Verified by re-running against a real key.
SECRET_HITS=$(git diff --cached | awk '
  BEGIN { ctx = "keccak|[Dd]igest|[Hh]ash|HASH|assertEq|bytes32|TYPEHASH|DOMAIN_SEPARATOR|domainSeparator|blockHash|txHash|merkle|[Rr]oot" }
  { lines[NR] = $0 }
  END {
    for (i = 1; i <= NR; i++) {
      line = lines[i]
      if (line !~ /^\+/) continue
      if (line !~ /0x[a-fA-F0-9]{64}/) continue
      if (line ~ /process\.env/ || line ~ /PRIVATE_KEY[ \t]*=/ || line ~ /\.env/) continue
      window = lines[i-2] " " lines[i-1] " " line " " lines[i+1]
      if (window ~ ctx) continue
      print line
    }
  }')

if [ -n "$SECRET_HITS" ]; then
  echo "❌ Hardcoded private key detected!"
  echo "$SECRET_HITS" | head -3
  echo "   If this is a hash rather than a secret, name it (digest/hash/keccak) on a nearby line."
  exit 1
fi

# 1b. Block Claude as commit author (Co-Authored-By) - code using Anthropic SDK is allowed
# This only checks the commit message, not the code content
echo "🤖 Checking commit author..."
# Note: This check runs in prepare-commit-msg or commit-msg hook, not here
# Pre-commit runs before the message is written, so we skip this check here

# 2. TypeScript type check (only on staged .ts/.tsx files)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | head -20 || true)
if [ -n "$STAGED_TS" ]; then
  echo "📝 Type checking TypeScript files..."
  # `npx tsc | head` reports HEAD's exit status, not tsc's, and head always succeeds — so the
  # old `if ! ... | head -30` could never be true and this step passed unconditionally while
  # printing the errors. Capture first, then decide.
  TS_OUT=$(npx tsc --noEmit --skipLibCheck 2>&1) || TS_FAILED=1
  if [ -n "$TS_FAILED" ]; then
    echo "$TS_OUT" | head -30
    echo "❌ TypeScript errors found. Fix them before committing."
    exit 1
  fi
  echo "✅ TypeScript check passed"
fi

# 2b. The envio indexer is a separate TS project with its own tsconfig, so the ROOT tsc above
# never sees it. That blind spot already let a break through once (d50e015): a rename pass turned
# eight destructured event args into `const { _timestamp } = event.params`, renaming the property
# rather than the local, and nothing caught it until the subproject was compiled by hand.
#
# Only runs when something under empowertours-envio/ is staged, so the usual commit pays nothing.
STAGED_ENVIO=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^empowertours-envio/.*\.ts$' || true)
if [ -n "$STAGED_ENVIO" ]; then
  echo "📝 Type checking the envio indexer..."
  ENVIO_OUT=$(npx tsc --noEmit -p empowertours-envio/tsconfig.json 2>&1) || ENVIO_FAILED=1
  if [ -n "$ENVIO_FAILED" ]; then
    # One pre-existing error lives here: `event.transaction.from` on
    # DailyLottery_TicketPurchased. Failing the commit on that would block every envio change
    # until it is fixed, so it is filtered by name rather than by count — a new error of any
    # other shape still stops the commit.
    ENVIO_REAL=$(echo "$ENVIO_OUT" | grep -v "DailyLottery_TicketPurchased" || true)
    if [ -n "$ENVIO_REAL" ]; then
      echo "$ENVIO_REAL" | head -30
      echo "❌ TypeScript errors in empowertours-envio. Fix them before committing."
      exit 1
    fi
    echo "✅ Envio check passed (only the known DailyLottery error)"
  else
    echo "✅ Envio check passed"
  fi
fi

# 3. Lint staged files (warning only)
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$STAGED_JS" ]; then
  echo "🧹 Linting staged files..."
  # Blocking as of 2026-08-23, after the repo was taken from 4,181 lint errors to 0.
  #
  # Errors block; warnings do not. 82 warnings remain, 56 of them @next/next/no-img-element —
  # a performance suggestion, not a defect. Blocking on those would make the gate fire on
  # nearly every UI commit, and a gate that cries wolf is one people learn to bypass, which is
  # worse than no gate. So --max-warnings=0 is deliberately gone.
  #
  # Same capture-then-decide shape as the tsc step above: piping to head would hide the
  # exit status.
  LINT_OUT=$(echo "$STAGED_JS" | xargs npx eslint 2>&1) || LINT_FAILED=1
  if [ -n "$LINT_FAILED" ]; then
    echo "$LINT_OUT" | head -50
    echo "❌ ESLint errors found. Fix them before committing."
    exit 1
  fi
  echo "$LINT_OUT" | head -20
  echo "✅ Lint check passed"
fi

# 4. Check for large files (>1MB)
echo "📦 Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only | while read file; do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt 1048576 ]; then
      echo "$file ($(($size / 1024))KB)"
    fi
  fi
done)
if [ -n "$LARGE_FILES" ]; then
  echo "⚠️  Large files detected (>1MB):"
  echo "$LARGE_FILES"
  echo "   Consider using Git LFS or excluding these files."
fi

# 5. Prevent commits to main/master without PR (warning only)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "⚠️  Warning: Committing directly to $BRANCH branch"
fi

echo "✅ Pre-commit checks complete!"
